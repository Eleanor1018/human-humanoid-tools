{
  "name": "hhtools-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck:test && vitest run"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
